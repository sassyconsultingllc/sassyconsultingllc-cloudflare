    "theme:contrast": "node scripts/theme/contrast.mjs fall",
    "theme:check": "node scripts/theme/check.mjs",
    "theme:snap": "node scripts/theme/snap.mjs",
    "theme:diff": "node scripts/theme/diff.mjs",
    "theme:toggle": "node scripts/theme/toggle.mjs"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "r2"
  ],
  "author": "Sassy Consulting LLC",
  "license": "UNLICENSED",
