  "description": "Sassy Consulting LLC - Full-stack Cloudflare website",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "audit:links": "node scripts/audit-links.mjs",
    "smoke:store": "node scripts/smoke-store.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "predeploy": "node scripts/build-sitemap.mjs",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute sassy-db --file=./migrations/0001_init.sql",
